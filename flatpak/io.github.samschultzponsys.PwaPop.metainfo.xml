<component type="desktop-application">
  <id>io.github.samschultzponsys.PwaPop</id>
  <name>PWA Pop</name>
  <summary>Run web apps as tray-resident desktop apps</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.samschultzponsys"><name>Sam Schultz</name></developer>
  <description>
    <p>PWA Pop turns web apps such as Outlook, Claude or a web softphone into
    standalone desktop apps. Each one gets its own window, tray icon, login
    session, native notifications, unread badge and optional autostart.
    USB headsets work through WebHID, so call buttons keep working.</p>
  </description>
  <launchable type="desktop-id">io.github.samschultzponsys.PwaPop.desktop</launchable>
